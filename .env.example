# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://wvpponovopsgpepdxpty.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service key NUNCA vai aqui no app Next — fica só no motor (VPS).

# ===== App =====
NEXT_PUBLIC_APP_URL=https://app.farolia.store

# ===== Meta / WhatsApp Embedded Signup (Caso 1 / Tech Provider) =====
# Valores PÚBLICOS (expostos no browser por design). Segredos (App Secret, token
# do cliente) NUNCA entram no app Next — vivem só no .env do motor (VPS).
NEXT_PUBLIC_META_APP_ID=28626141177088716
NEXT_PUBLIC_META_CONFIG_ID=894112427046988
NEXT_PUBLIC_META_GRAPH_VERSION=v23.0
# O motor (VPS) usa, server-side: MOTOR_URL + MOTOR_TOKEN (já existentes),
# META_APP_ID, META_APP_SECRET (SEGREDO), META_GRAPH_VERSION.

# ===== Rate limiting global (Upstash Redis) — OPCIONAL =====
# Sem isto, o rate limit funciona em memória (por instância).
# Para limite global na Vercel, crie um banco grátis em upstash.com
# e cole as duas variáveis abaixo (REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
